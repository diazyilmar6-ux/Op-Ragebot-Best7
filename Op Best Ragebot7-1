local function getTriggerPart(enemyList)
cam=workspace.CurrentCamera
if not cam or #enemyList==0 then return nil,nil end
local center=Vector2.new(cam.ViewportSize.X*0.5,cam.ViewportSize.Y*0.5)
local fovR=tonumber(getgenv().Config.TriggerFOV)or 115
local bestPart,bestPlayer,bestMag=nil,nil,math.huge
for _,e in ipairs(enemyList)do
for _,pt in ipairs({e.head,e.root})do
if pt and pt.Parent then
local sp,onScreen=cam:WorldToViewportPoint(pt.Position)
if onScreen and sp.Z>0 then
local mag=(Vector2.new(sp.X,sp.Y)-center).Magnitude
if mag<=fovR and mag<bestMag then bestMag,bestPart,bestPlayer=mag,pt,e.player end
end
end
end
end
return bestPart,bestPlayer
end

