local function shouldForceMeleeEquip()
if not getgenv().Config.AutoMeleeEnemy then return false end
if not enemyBladeHoldPlayer or not enemyBladeHoldStart then return false end
if not hasEnemyLongBlade(enemyBladeHoldPlayer)then return false end
local holdTime=tick()-enemyBladeHoldStart
local threshold=tonumber(getgenv().Config.EnemyMeleeHoldThreshold)or 1.2
return holdTime>=threshold
end

