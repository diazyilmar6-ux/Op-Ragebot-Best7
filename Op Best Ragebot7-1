local function isEnemy(p)
if not p or p==lplr then return false end
local duel=SpectateController.CurrentDuelSubject
if duel and duel.Duelers then
local myTeam=nil
for _,du in ipairs(duel.Duelers)do if du.Player==lplr then myTeam=du:Get("TeamID")if myTeam==nil then myTeam=du.TeamID end break end end
if myTeam~=nil then
for _,du in ipairs(duel.Duelers)do if du.Player==p then local theirTeam=du:Get("TeamID")if theirTeam==nil then theirTeam=du.TeamID end if theirTeam~=nil then return theirTeam~=myTeam end end end
end
end
if lplr:GetAttribute("TeamID")~=nil and p:GetAttribute("TeamID")~=nil then return lplr:GetAttribute("TeamID")~=p:GetAttribute("TeamID")end
if lplr.Team and p.Team then return lplr.Team~=p.Team end
return true
end

